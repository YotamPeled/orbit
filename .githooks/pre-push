#!/usr/bin/env bash
# Every commit a push would publish is held to scripts/personal_strings.py: its files, its
# message and its author. A commit that slipped past the pre-commit hook (`--no-verify`, a
# clone without the hooks) stops here.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
py=python3; "$py" -c 'import sys' >/dev/null 2>&1 || py=python
zero=0000000000000000000000000000000000000000
rc=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # a deletion publishes nothing
  "$py" "$root/scripts/personal_strings.py" --push "$remote_sha" "$local_sha" || rc=1
done
exit $rc
