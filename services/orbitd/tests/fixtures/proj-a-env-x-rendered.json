[
  {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "name": "proj-a-env-x",
      "labels": {
        "orbit.local/project": "proj-a",
        "orbit.local/env": "env-x"
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ResourceQuota",
    "metadata": {
      "name": "orbit-quota",
      "namespace": "proj-a-env-x"
    },
    "spec": {
      "hard": {
        "pods": "6",
        "requests.cpu": "500m"
      }
    }
  },
  {
    "apiVersion": "opentelemetry.io/v1alpha1",
    "kind": "Instrumentation",
    "metadata": {
      "name": "orbit",
      "namespace": "proj-a-env-x"
    },
    "spec": {
      "exporter": {
        "endpoint": "http://tempo.tempo.svc:4318"
      }
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "default-deny-ingress",
      "namespace": "proj-a-env-x"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": ["Ingress"]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "grafana-dashboard-red-proj-a-env-x",
      "namespace": "monitoring",
      "labels": {
        "grafana_dashboard": "1"
      }
    },
    "data": {
      "red-proj-a-env-x.json": "{}"
    }
  },
  {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "Probe",
    "metadata": {
      "name": "tenant-probe-ax",
      "namespace": "monitoring",
      "labels": {
        "orbit.local/project": "proj-a",
        "orbit.local/env": "env-x"
      }
    },
    "spec": {
      "module": "http_2xx"
    }
  }
]
